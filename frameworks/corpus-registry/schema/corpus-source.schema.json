{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sauti-labs.dev/schemas/corpus-source.schema.json",
  "title": "Corpus Source",
  "description": "Defines the required metadata for every written-text source tracked in the Language Corpus Platform, per the Master Blueprint Pillar III. Distinct from dataset-framework: this schema tracks bibliographic provenance of raw text sources, not processed multi-modal datasets.",
  "type": "object",
  "required": [
    "source_id",
    "title",
    "languages",
    "source_type",
    "copyright_status",
    "status"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "description": "Unique identifier, e.g. 'kiswahili-newspaper-taifa-leo-2020-2025'."
    },
    "title": {
      "type": "string",
      "description": "Title of the source document, publication, or collection."
    },
    "languages": {
      "type": "array",
      "items": { "type": "string" },
      "description": "ISO codes of languages covered, cross-referenced to Codex Layer 2."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "book",
        "literature",
        "government_document",
        "academic_publication",
        "newspaper",
        "educational_resource",
        "historical_archive",
        "community_contribution",
        "digital_content"
      ]
    },
    "author_or_publisher": {
      "type": "string"
    },
    "publication_date": {
      "type": "string",
      "description": "ISO 8601 date or year, e.g. '2024' or '2024-03-15'."
    },
    "copyright_status": {
      "type": "string",
      "enum": [
        "public_domain",
        "licensed",
        "permission_granted",
        "fair_use_research",
        "proprietary_internal",
        "unknown_pending_review"
      ],
      "description": "Copyright must never be assumed. 'unknown_pending_review' blocks use until resolved."
    },
    "license_details": {
      "type": "string",
      "description": "Specific license terms or permission reference, if applicable."
    },
    "status": {
      "type": "string",
      "enum": ["identified", "acquiring", "processing", "available", "excluded"]
    },
    "text_size_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "digitization_method": {
      "type": "string",
      "enum": ["born_digital", "ocr", "manual_transcription", "not_applicable"]
    },
    "linked_dataset_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Cross-reference to dataset-framework registry entries derived from this source."
    },
    "notes": {
      "type": "string"
    }
  }
}
